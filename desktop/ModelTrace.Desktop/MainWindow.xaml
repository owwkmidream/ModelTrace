<Window x:Class="ModelTrace.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ModelTrace" Height="860" Width="1240"
        MinHeight="640" MinWidth="980"
        Background="{DynamicResource Bg}"
        FontFamily="{DynamicResource UiFont}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 概率条：宽度按概率比例，最大 160 -->
        <DataTemplate x:Key="ScoreRowTemplate">
            <Border Background="{DynamicResource SurfaceSoft}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="7" Padding="12,10" Margin="0,0,0,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="12.5"
                               FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Height="7" Width="{Binding BarWidth}" CornerRadius="99"
                                Background="{DynamicResource Primary}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ProbabilityText}" Margin="9,0,0,0" FontSize="11.5"
                                   Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Margin="14,0,0,0" FontSize="11"
                               Foreground="{DynamicResource Muted}" VerticalAlignment="Center">
                        <Run Text="{Binding FamilyName, Mode=OneWay}" />
                        <Run Text="· 家族内" />
                        <Run Text="{Binding ConditionalText, Mode=OneWay}" />
                        <Run Text="· 相似度" />
                        <Run Text="{Binding SimilarityText, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Grid.Column="3" Text="最高" FontSize="10.5" Padding="7,3"
                               Foreground="{DynamicResource OnPrimary}"
                               Background="{DynamicResource Primary}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTop}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 挑战卡片 -->
        <DataTemplate x:Key="ChallengeTemplate">
            <Border Style="{DynamicResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <Border Background="{DynamicResource SurfaceSoft}" Padding="14,10"
                            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                            CornerRadius="9,9,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="挑战" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource Text}" />
                            <TextBlock Margin="10,0,0,0" FontSize="11.5"
                                       Foreground="{DynamicResource Muted}">
                                <Run Text="需要" />
                                <Run Text="{Binding ExpectedCount, Mode=OneWay}" />
                                <Run Text="个 1 到 355 的整数" />
                            </TextBlock>
                            <Button Content="复制" Style="{DynamicResource SecondaryButton}"
                                    Padding="9,3" MinHeight="24" FontSize="11" Margin="14,0,0,0"
                                    Command="{Binding DataContext.CopyChallengeCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="14">
                        <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource Text}" Margin="0,0,0,12" />
                        <TextBlock Text="粘贴该模型的完整回答" Style="{DynamicResource FieldLabel}" />
                        <TextBox Style="{DynamicResource FieldBox}" Height="96"
                                 Text="{Binding Output, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" Padding="9,7" />
                        <TextBlock Text="{Binding Diagnostic}" Style="{DynamicResource MutedText}"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 端点尝试卡片 -->
        <DataTemplate x:Key="EndpointTemplate">
            <Border Style="{DynamicResource Card}" Margin="0,0,0,8" Padding="11">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" />
                    <TextBlock Text="{Binding Status}" FontSize="11" Margin="0,4,0,0"
                               Foreground="{Binding StatusBrush}" />
                    <TextBlock Text="{Binding Body}" Style="{DynamicResource MonoText}"
                               Margin="0,6,0,0" MaxHeight="110" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 历史条目 -->
        <DataTemplate x:Key="HistoryTemplate">
            <Border Style="{DynamicResource Card}" Padding="14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding RequestedModel}" FontWeight="SemiBold" FontSize="12.5"
                                   Foreground="{DynamicResource Text}" />
                        <TextBlock Text="{Binding StartedAt}" Margin="12,0,0,0" FontSize="11"
                                   Foreground="{DynamicResource Muted}" />
                        <Border Margin="12,0,0,0" Padding="9,3" CornerRadius="999"
                                Background="{DynamicResource PrimarySoft}">
                            <TextBlock Text="{Binding Status}" FontSize="10.5"
                                       Foreground="{DynamicResource Primary}" />
                        </Border>
                        <Button Content="复制摘要" Style="{DynamicResource SecondaryButton}"
                                Padding="9,3" MinHeight="24" FontSize="11" Margin="12,0,0,0"
                                Command="{Binding DataContext.CopyHistoryCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>

                    <TextBlock Margin="0,9,0,0" FontSize="11.5" Foreground="{DynamicResource Muted}">
                        <Run Text="预测：" />
                        <Run Text="{Binding PredictedName, Mode=OneWay}" />
                        <Run Text="　概率：" />
                        <Run Text="{Binding Probability, Mode=OneWay, StringFormat={}{0:P2}}" />
                        <Run Text="　计入：" />
                        <Run Text="{Binding UsedOutputs, Mode=OneWay}" />
                        <Run Text=" 份　地址：" />
                        <Run Text="{Binding BaseUrl, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Text="{Binding Note}" Margin="0,7,0,0" FontSize="11"
                               Foreground="{DynamicResource Warning}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── 顶栏 ── -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="29" Height="29" CornerRadius="6"
                            Background="{DynamicResource Primary}">
                        <TextBlock Text="MT" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource OnPrimary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="ModelTrace" FontSize="15" FontWeight="Bold" Margin="10,0,0,0"
                               Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Border Padding="10,6" CornerRadius="999"
                            Background="{DynamicResource SuccessSoft}"
                            BorderBrush="{DynamicResource Success}" BorderThickness="1">
                        <TextBlock Text="{Binding BankSummary}" FontSize="11"
                                   Foreground="{DynamicResource Success}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── 侧栏 ── -->
            <Border Grid.Column="0" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <Grid Margin="12,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <RadioButton Style="{DynamicResource NavButton}" Tag="01" GroupName="nav"
                                     IsChecked="{Binding IsTestWorkspace, Mode=OneWay}"
                                     Command="{Binding ShowTestCommand}">
                            <TextBlock Text="模型测试" />
                        </RadioButton>
                        <RadioButton Style="{DynamicResource NavButton}" Tag="02" GroupName="nav"
                                     IsChecked="{Binding IsLibraryWorkspace, Mode=OneWay}"
                                     Command="{Binding ShowLibraryCommand}">
                            <TextBlock Text="指纹库与设置" />
                        </RadioButton>
                        <RadioButton Style="{DynamicResource NavButton}" Tag="03" GroupName="nav"
                                     IsChecked="{Binding IsHistoryWorkspace, Mode=OneWay}"
                                     Command="{Binding ShowHistoryCommand}">
                            <TextBlock Text="历史记录" />
                        </RadioButton>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <!-- 主题切换：与网页版 .theme-toggle 一致 —— 带图标槽的导航式按钮。
                             图标槽与上方 01/02/03 同尺寸同圆角，但无选中高亮态。 -->
                        <Button Style="{DynamicResource ThemeToggleButton}"
                                Tag="{Binding ThemeIcon}"
                                Content="{Binding ThemeLabel}"
                                Command="{Binding ToggleThemeCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── 主内容 ── -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource Bg}">
                <Grid Margin="26,22">

                    <!-- ══ 工作区 1：模型测试 ══ -->
                    <StackPanel Visibility="{Binding IsTestWorkspace,
                                             Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="模型测试" Style="{DynamicResource PageTitle}" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,14">
                            <Border Padding="3" CornerRadius="8"
                                    Background="{DynamicResource TabsBg}"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{DynamicResource SegmentedItem}" GroupName="mode"
                                                 MinWidth="132"
                                                 IsChecked="{Binding IsManualMode, Mode=OneWay}"
                                                 Command="{Binding ManualModeCommand}"
                                                 Content="手动测试" />
                                    <RadioButton Style="{DynamicResource SegmentedItem}" GroupName="mode"
                                                 MinWidth="132"
                                                 IsChecked="{Binding IsApiMode, Mode=OneWay}"
                                                 Command="{Binding ApiModeCommand}"
                                                 Content="API 自动测试" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 手动测试 -->
                        <StackPanel Visibility="{Binding IsManualMode,
                                                 Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{DynamicResource Card}" Padding="13,11">
                                <Grid>
                                    <TextBlock Text="三次挑战" Style="{DynamicResource SectionTitle}"
                                               VerticalAlignment="Center" />
                                    <Button Content="重新生成" HorizontalAlignment="Right"
                                            Style="{DynamicResource SecondaryButton}"
                                            Command="{Binding RegenerateCommand}" />
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding ManualChallenges}"
                                          ItemTemplate="{StaticResource ChallengeTemplate}"
                                          Margin="0,10,0,0" />
                            <Button Content="计算归因概率" HorizontalAlignment="Right"
                                    Style="{DynamicResource PrimaryButton}"
                                    Command="{Binding AnalyzeCommand}" />
                        </StackPanel>

                        <!-- API 自动测试 -->
                        <StackPanel Visibility="{Binding IsApiMode,
                                                 Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{DynamicResource Card}" Padding="17">
                                <StackPanel>
                                    <TextBlock Text="接口参数" Style="{DynamicResource SectionTitle}"
                                               Margin="0,0,0,14" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,7,14">
                                            <TextBlock Text="Base URL" Style="{DynamicResource FieldLabel}" />
                                            <TextBox Style="{DynamicResource FieldBox}"
                                                     Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="7,0,0,14">
                                            <TextBlock Text="接口模型名" Style="{DynamicResource FieldLabel}" />
                                            <TextBox Style="{DynamicResource FieldBox}"
                                                     Text="{Binding ApiModel, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,7,0">
                                            <TextBlock Text="API Key" Style="{DynamicResource FieldLabel}" />
                                            <TextBox Style="{DynamicResource FieldBox}"
                                                     Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="7,0,0,0">
                                            <TextBlock Text="温度（可选）" Style="{DynamicResource FieldLabel}" />
                                            <TextBox Style="{DynamicResource FieldBox}"
                                                     Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <Button Content="单步测试" Style="{DynamicResource SecondaryButton}"
                                                Command="{Binding StepTestCommand}" />
                                        <Button Content="开始测试" Style="{DynamicResource PrimaryButton}"
                                                Margin="10,0,0,0" Command="{Binding StartTestCommand}" />
                                        <Button Content="探测上游模型名" Style="{DynamicResource SecondaryButton}"
                                                Margin="10,0,0,0" Command="{Binding ProbeModelsCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 已存配置 -->
                            <Border Style="{DynamicResource Card}" Padding="17" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="已存配置" Style="{DynamicResource SectionTitle}"
                                               Margin="0,0,0,12" />
                                    <ItemsControl ItemsSource="{Binding SavedConfigs}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceSoft}"
                                                        BorderBrush="{DynamicResource LineStrong}"
                                                        BorderThickness="1" CornerRadius="8"
                                                        Padding="11,8" Margin="0,0,8,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Text}" />
                                                        <TextBlock Text="{Binding BaseUrl}" FontSize="10.5"
                                                                   Foreground="{DynamicResource Muted}" />
                                                        <TextBlock Text="{Binding MaskedKey}" FontSize="10.5"
                                                                   FontFamily="{DynamicResource MonoFont}"
                                                                   Foreground="{DynamicResource Muted}" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                            <Button Content="载入" Padding="8,2" MinHeight="22"
                                                                    FontSize="10.5"
                                                                    Style="{DynamicResource SecondaryButton}"
                                                                    Command="{Binding DataContext.LoadConfigCommand,
                                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Content="删除" Padding="8,2" MinHeight="22"
                                                                    FontSize="10.5" Margin="6,0,0,0"
                                                                    Style="{DynamicResource DangerButton}"
                                                                    Command="{Binding DataContext.DeleteConfigCommand,
                                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBox Style="{DynamicResource FieldBox}" Width="200"
                                                 Text="{Binding NewConfigName, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Content="保存当前 Base URL 与 API Key"
                                                Style="{DynamicResource PrimaryButton}" Margin="10,0,0,0"
                                                Command="{Binding SaveConfigCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 任务标签 -->
                            <ItemsControl ItemsSource="{Binding Sessions}" Margin="0,14,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Surface}"
                                                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                                CornerRadius="8" Padding="11,7" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding TabLabel}" FontSize="11.5"
                                                           Foreground="{DynamicResource Text}"
                                                           VerticalAlignment="Center" />
                                                <Button Content="查看" Padding="7,2" MinHeight="22"
                                                        FontSize="10.5" Margin="9,0,0,0"
                                                        Style="{DynamicResource SecondaryButton}"
                                                        Command="{Binding DataContext.FocusSessionCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="×" Padding="7,2" MinHeight="22"
                                                        FontSize="10.5" Margin="5,0,0,0"
                                                        Style="{DynamicResource DangerButton}"
                                                        Command="{Binding DataContext.CloseSessionCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 进度 -->
                            <Border Style="{DynamicResource Card}" Padding="15" Margin="0,6,0,0"
                                    Visibility="{Binding HasActiveSession,
                                                 Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding ActiveSession.Status}" FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding ActiveSession.CountText}" FontSize="11"
                                                       Foreground="{DynamicResource Muted}"
                                                       VerticalAlignment="Center" />
                                            <Button Content="继续下一轮" Padding="9,3" MinHeight="24"
                                                    FontSize="11" Margin="9,0,0,0"
                                                    Style="{DynamicResource SecondaryButton}"
                                                    Command="{Binding ResumeTestCommand}" />
                                            <Button Content="停止当前任务" Padding="9,3" MinHeight="24"
                                                    FontSize="11" Margin="6,0,0,0"
                                                    Style="{DynamicResource SecondaryButton}"
                                                    Command="{Binding StopTestCommand}" />
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar Style="{DynamicResource ProgressFill}" Margin="0,10,0,0"
                                                 Value="{Binding ActiveSession.Progress, Mode=OneWay}"
                                                 Maximum="1" />
                                    <ItemsControl ItemsSource="{Binding ActiveSession.Endpoints}"
                                                  ItemTemplate="{StaticResource EndpointTemplate}"
                                                  Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 结果 -->
                            <Border Style="{DynamicResource Card}" Padding="17" Margin="0,14,0,0"
                                    Visibility="{Binding HasActiveSession,
                                                 Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActiveResultSummary}" FontSize="12.5"
                                               FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Text}" />
                                    <TextBlock Text="{Binding ActiveDiagnosticsText}" FontSize="11"
                                               Margin="0,8,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Muted}" />
                                    <ItemsControl ItemsSource="{Binding ActiveScoreRows}"
                                                  ItemTemplate="{StaticResource ScoreRowTemplate}"
                                                  Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 结果（手动模式） -->
                        <Border Style="{DynamicResource Card}" Padding="17" Margin="0,14,0,0"
                                Visibility="{Binding HasManualResult,
                                             Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding ManualSummaryText}" FontSize="12.5"
                                           FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Text}" />
                                <TextBlock Text="{Binding ManualDiagnosticsText}" FontSize="11"
                                           Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Muted}" />
                                <ItemsControl ItemsSource="{Binding ManualScoreRows}"
                                              ItemTemplate="{StaticResource ScoreRowTemplate}"
                                              Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- 消息条 -->
                        <Border Margin="0,14,0,0" Padding="12" CornerRadius="7"
                                Visibility="{Binding HasMessage,
                                             Converter={StaticResource BoolToVisibility}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MessageIsError}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource SuccessSoft}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Text}" />
                        </Border>
                    </StackPanel>

                    <!-- ══ 工作区 2：指纹库与设置 ══ -->
                    <StackPanel Visibility="{Binding IsLibraryWorkspace,
                                             Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="指纹库与设置" Style="{DynamicResource PageTitle}" />

                        <Border Style="{DynamicResource Card}" Padding="17" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="当前指纹库" Style="{DynamicResource SectionTitle}" />
                                <TextBlock Text="{Binding BankBuiltAt}" Style="{DynamicResource MutedText}"
                                           Margin="0,7,0,0" />
                                <TextBlock Text="{Binding BankMethod}" Style="{DynamicResource MutedText}"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="候选模型" Style="{DynamicResource FieldLabel}"
                                           Margin="0,14,0,6" />
                                <ItemsControl ItemsSource="{Binding BankModelIds}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceSoft}"
                                                    BorderBrush="{DynamicResource Line}"
                                                    BorderThickness="1" CornerRadius="6"
                                                    Padding="9,6" Margin="0,0,7,7">
                                                <TextBlock Text="{Binding}" FontSize="11.5"
                                                           FontFamily="{DynamicResource MonoFont}"
                                                           Foreground="{DynamicResource Text}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 指纹库更新 -->
                        <Border Style="{DynamicResource Card}" Padding="17" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="指纹库更新" Style="{DynamicResource SectionTitle}" />
                                <TextBlock Style="{DynamicResource MutedText}" Margin="0,7,0,12"
                                           TextWrapping="Wrap"
                                           Text="默认指向上游原仓库，一般无需修改。检查到新指纹库时只替换数据文件，无需重装程序。" />
                                <TextBox Style="{DynamicResource FieldBox}"
                                         Text="{Binding ChannelUrl, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="检查更新" Style="{DynamicResource SecondaryButton}"
                                            Command="{Binding CheckUpdateCommand}" />
                                    <Button Content="下载并应用" Style="{DynamicResource PrimaryButton}"
                                            Margin="10,0,0,0" Command="{Binding ApplyUpdateCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding UpdateMessage}" FontSize="11.5" Margin="0,10,0,0"
                                           TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                            </StackPanel>
                        </Border>

                        <!-- 从网页版迁移 -->
                        <Border Style="{DynamicResource Card}" Padding="17" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="从网页版迁移" Style="{DynamicResource SectionTitle}" />
                                <TextBlock Style="{DynamicResource MutedText}" Margin="0,7,0,12"
                                           TextWrapping="Wrap"
                                           Text="把网页版存在浏览器里的「已存配置」与「历史记录」搬过来。先在网页版导出，再在此导入；重复条目会按名称 / Id 自动跳过。" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="导出控制台脚本" Style="{DynamicResource SecondaryButton}"
                                            Command="{Binding ExportWebScriptCommand}" />
                                    <Button Content="导入导出文件" Style="{DynamicResource PrimaryButton}"
                                            Margin="10,0,0,0" Command="{Binding ImportWebDataCommand}" />
                                </StackPanel>
                                <TextBlock Style="{DynamicResource MutedText}" Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Text="用法：点「导出控制台脚本」存到本地 → 在网页版按 F12 打开控制台 → 粘贴脚本内容并回车 → 下载得到 json → 回到这里点「导入导出文件」。" />
                            </StackPanel>
                        </Border>

                        <!-- 开始菜单项 -->
                        <Border Style="{DynamicResource Card}" Padding="17" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="开始菜单项" Style="{DynamicResource SectionTitle}" />
                                <TextBlock Text="{Binding StartMenuStatus}" Style="{DynamicResource MutedText}"
                                           Margin="0,7,0,12" TextWrapping="Wrap" />
                                <Button Content="添加 / 移除开始菜单项" HorizontalAlignment="Left"
                                        Style="{DynamicResource PrimaryButton}"
                                        Command="{Binding ToggleStartMenuCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- 采集指纹 -->
                        <Border Style="{DynamicResource Card}" Padding="17" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="新建指纹（采集回答）"
                                           Style="{DynamicResource SectionTitle}" />
                                <TextBlock Style="{DynamicResource MutedText}" Margin="0,7,0,12"
                                           TextWrapping="Wrap"
                                           Text="自动向上游采集若干份回答并落盘为 jsonl，再交给仓库的 bank_builder.py 拟合。采集过程会真实消耗上游额度。" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,7,14">
                                        <TextBlock Text="Base URL" Style="{DynamicResource FieldLabel}" />
                                        <TextBox Style="{DynamicResource FieldBox}"
                                                 Text="{Binding EnrollBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="7,0,0,14">
                                        <TextBlock Text="模型名" Style="{DynamicResource FieldLabel}" />
                                        <TextBox Style="{DynamicResource FieldBox}"
                                                 Text="{Binding EnrollApiModel, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,7,14">
                                        <TextBlock Text="API Key" Style="{DynamicResource FieldLabel}" />
                                        <TextBox Style="{DynamicResource FieldBox}"
                                                 Text="{Binding EnrollApiKey, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="7,0,0,14">
                                        <TextBlock Text="指纹名称" Style="{DynamicResource FieldLabel}" />
                                        <TextBox Style="{DynamicResource FieldBox}"
                                                 Text="{Binding EnrollModelLabel, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,7,0">
                                        <TextBlock Text="采集回答数（3-36）"
                                                   Style="{DynamicResource FieldLabel}" />
                                        <TextBox Style="{DynamicResource FieldBox}"
                                                 Text="{Binding EnrollSampleCount, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="开始采集" Style="{DynamicResource PrimaryButton}"
                                            Command="{Binding EnrollCommand}" />
                                    <Button Content="说明" Style="{DynamicResource SecondaryButton}"
                                            Margin="10,0,0,0" Command="{Binding CreateBankCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding EnrollMessage}" FontSize="11.5" Margin="0,10,0,0"
                                           TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ══ 工作区 3：历史记录 ══ -->
                    <StackPanel Visibility="{Binding IsHistoryWorkspace,
                                             Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <TextBlock Text="历史记录" Style="{DynamicResource PageTitle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Padding="10,6" CornerRadius="999"
                                        Background="{DynamicResource SuccessSoft}"
                                        BorderBrush="{DynamicResource Success}" BorderThickness="1">
                                    <TextBlock Text="{Binding HistoryCountText}" FontSize="11"
                                               Foreground="{DynamicResource Success}" />
                                </Border>
                                <Button Content="清空全部" Style="{DynamicResource SecondaryButton}"
                                        Margin="10,0,0,0" Command="{Binding ClearHistoryCommand}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,16,0,14">
                            <TextBox Style="{DynamicResource FieldBox}" Width="300"
                                     HorizontalAlignment="Left"
                                     Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}" />
                            <Border HorizontalAlignment="Right" Padding="3" CornerRadius="8"
                                    Background="{DynamicResource TabsBg}"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{DynamicResource SegmentedItem}" GroupName="cons"
                                                 Content="全部"
                                                 IsChecked="{Binding HistoryConsistency,
                                                             Converter={StaticResource IsAllConverter},
                                                             Mode=OneWay}"
                                                 Command="{Binding SetConsistencyAllCommand}" />
                                    <RadioButton Style="{DynamicResource SegmentedItem}" GroupName="cons"
                                                 Content="一致"
                                                 IsChecked="{Binding HistoryConsistency,
                                                             Converter={StaticResource IsSameConverter},
                                                             Mode=OneWay}"
                                                 Command="{Binding SetConsistencySameCommand}" />
                                    <RadioButton Style="{DynamicResource SegmentedItem}" GroupName="cons"
                                                 Content="不一致"
                                                 IsChecked="{Binding HistoryConsistency,
                                                             Converter={StaticResource IsDiffConverter},
                                                             Mode=OneWay}"
                                                 Command="{Binding SetConsistencyDiffCommand}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding HistoryView}"
                                      ItemTemplate="{StaticResource HistoryTemplate}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
