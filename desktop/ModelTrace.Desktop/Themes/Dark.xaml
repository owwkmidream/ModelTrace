<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      深色主题：覆盖 Design.xaml 里的同名资源。
      色值与 static/styles.css 的 [data-theme="dark"] 一节对应。
      切换主题时由 ThemeSwapper 在合并字典中替换本字典。
    -->

    <SolidColorBrush x:Key="Bg" Color="#FF0F141C" />
    <SolidColorBrush x:Key="Surface" Color="#FF161D28" />
    <SolidColorBrush x:Key="SurfaceSoft" Color="#FF1C2432" />
    <SolidColorBrush x:Key="Text" Color="#FFE6EBF2" />
    <SolidColorBrush x:Key="Muted" Color="#FF98A2B3" />
    <SolidColorBrush x:Key="Line" Color="#FF26303F" />
    <SolidColorBrush x:Key="LineStrong" Color="#FF374252" />
    <SolidColorBrush x:Key="Primary" Color="#FF3B82F6" />
    <SolidColorBrush x:Key="PrimaryDark" Color="#FF2563EB" />
    <SolidColorBrush x:Key="PrimarySoft" Color="#FF1B2740" />
    <SolidColorBrush x:Key="Success" Color="#FF4ADE80" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#FF14261C" />
    <SolidColorBrush x:Key="Warning" Color="#FFFACC15" />
    <SolidColorBrush x:Key="WarningSoft" Color="#FF2A2310" />
    <SolidColorBrush x:Key="Danger" Color="#FFF87171" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FF2A1615" />
    <SolidColorBrush x:Key="ControlTrack" Color="#FF2A3444" />
    <SolidColorBrush x:Key="TabsBg" Color="#FF1A222E" />
    <SolidColorBrush x:Key="CodeSurface" Color="#FF141B26" />
    <SolidColorBrush x:Key="LabelBrush" Color="#FFCBD5E1" />
    <SolidColorBrush x:Key="OnPrimary" Color="#FF0F141C" />

</ResourceDictionary>
